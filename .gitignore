# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地缓存（pytest 在受限目录下建不出来时会在仓库根留下 pytest-cache-files-*）
.pytest_cache/
.ruff_cache/
.mypy_cache/
pytest-cache-files-*/

# 测试依赖（见 tests/README.md）
.testlibs/

# 本地配置与私密文件
.env
# 锚定到仓库根：无锚定的 config/ 会连包目录里任何叫 config/ 的子目录一起吞掉
# （server_log_filter/config/… 会被静默忽略，git add 既不报错也不加入）。
/config/

# 构建产物（.mcdr 请通过 Releases 分发）
*.mcdr
Releases/
build/
dist/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
